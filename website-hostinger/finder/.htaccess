Options -Indexes
DirectoryIndex index.html
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "no-referrer"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Content-Security-Policy "default-src 'self'; connect-src https://permuta-api.vgventures.com.br; style-src 'self' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; script-src 'self'; img-src 'self' data: https://imgbr.imovelwebcdn.com https://si9dados3.com.br; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'self'"
</IfModule>
